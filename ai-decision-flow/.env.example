# Copy to .env and edit. Any OpenAI-compatible provider works
# (Ollama local, Groq, OpenRouter...). The frontend needs no keys:
# the server talks to the LLM.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:0.6b
PORT=8001
# Local Inngest dev mode (no signing key needed). Set to 0 for production.
INNGEST_DEV=1
# Any value works with the local dev server.
INNGEST_EVENT_KEY=local