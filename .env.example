# Copy this file to .env and edit. .env is git-ignored (secrets stay local).
# The API and src/llm read these at runtime via python-dotenv.

# OpenAI-compatible provider. Ollama local: http://localhost:11434/v1
# OpenRouter (25k free): https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:0.6b

# Stub mode: no network, deterministic rule-based verdicts (dev/tests).
LLM_STUB=0
# Kill switch: false -> /jobs/triage answers 503 Service Unavailable.
LLM_ENABLED=true

# Resilience policy for the LLM call.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_COST_PER_1K_TOKENS=0

# Background job subsystem (BE-06).
WORKER_COUNT=2
JOB_MAX_ATTEMPTS=3
# Optional: POST JSON alerts here when a job fails permanently (else alerts.jsonl only).
ALERT_WEBHOOK_URL=